{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Held in Common Node",
  "version": "0.1.0",
  "identifier": "org.heldincommon.node",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Held in Common — Node", "width": 1100, "height": 820 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/hic-commons"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
