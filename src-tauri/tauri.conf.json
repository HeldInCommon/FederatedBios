{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Held in Common",
  "version": "0.1.0",
  "identifier": "org.heldincommon.onboarding",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Held in Common — Local Node",
        "width": 1100,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
